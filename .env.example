# All server-only. Never prefix these with NEXT_PUBLIC_.

# Bot token from discord.com/developers > your app > Bot
DISCORD_BOT_TOKEN=your-bot-token
# Server ID (Developer Mode on, right-click the server, Copy ID)
DISCORD_GUILD_ID=123456789012345678
# Channel the "From the hall" feed reads
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=123456789012345678
# Channel whose latest pin lists open seats
DISCORD_RECRUITMENT_CHANNEL_ID=123456789012345678
# Permanent invite (never expires, unlimited uses), used by every join link
DISCORD_INVITE_URL=https://discord.gg/xxxx
# Set to 1 to use src/lib/fixtures.ts instead of calling Discord
DISCORD_MOCK=1
